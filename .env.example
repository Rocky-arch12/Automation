# AlphaSignal AI - Configuration

# Server
PORT=8000
HOST=127.0.0.1

# AI Provider: "groq" or "gemini" or "smart_fallback"
AI_PROVIDER=groq

# Free Groq API Key (get free key at https://console.groq.com)
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Free Google Gemini API Key (alternative free tier from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Telegram Bot Listener (for test channel or group)
# Create a bot via @BotFather and add as admin to your test channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Telegram User Client (Optional - for reading channels where bots are not allowed)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Optional Google OAuth Single Sign-On Client ID (from console.cloud.google.com)
GOOGLE_CLIENT_ID=

# MongoDB Atlas Logging Configuration (Cloud persistence with 7-Day Auto-Purge TTL)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=alphasignal_logs
MONGODB_LOG_TTL_DAYS=7


